-- Таблица: loyalty_point_transactions
CREATE TABLE loyalty_point_transactions (
    id           INTEGER PRIMARY KEY,
    account_id   INTEGER NOT NULL,
    sale_id      INTEGER,
    tx_type      TEXT NOT NULL CHECK (tx_type IN ('EARN', 'SPEND', 'ADJUST', 'EXPIRE')),
    points_delta INTEGER NOT NULL,
    tx_datetime  TEXT NOT NULL,
    comment      TEXT,
    FOREIGN KEY (account_id) REFERENCES loyalty_accounts(id)
        ON UPDATE CASCADE
        ON DELETE CASCADE,
    FOREIGN KEY (sale_id) REFERENCES sales(id)
        ON UPDATE CASCADE
        ON DELETE SET NULL
);
