SELECT 
    ROUND((SELECT ROUND(SUM(applied_amount), 2) FROM sale_coupons), 2) AS coupon_discount_total,
    ROUND((SELECT ROUND(SUM((quantity * unit_price) - discount_amount), 2) FROM sale_items), 2) AS sales_net_total,
    ROUND((SELECT SUM(applied_amount) FROM sale_coupons) / (SELECT SUM((quantity * unit_price) - discount_amount) FROM sale_items) *100, 2) AS coupon_share_percent;
