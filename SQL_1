WITH table_sale_amount AS
    (SELECT
        sale_id,
        SUM((unit_price * quantity) - discount_amount) AS sale_amount_1
    FROM sale_items
    GROUP BY sale_id
    )
SELECT
    customer_id,
    sales.id AS sale_id,
    table_sale_amount.sale_amount_1 AS sale_amount,
    SUM(table_sale_amount.sale_amount_1) OVER (PARTITION BY customer_id ORDER BY customer_id) AS customer_total_amount,
    ROUND(((table_sale_amount.sale_amount_1) / SUM(table_sale_amount.sale_amount_1) OVER (PARTITION BY customer_id ORDER BY customer_id)) * 100, 2) AS sale_share_percent
FROM sales
    JOIN table_sale_amount
        ON table_sale_amount.sale_id = sales.id
ORDER BY customer_id, sale_amount DESC;
